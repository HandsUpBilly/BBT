{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "generate:seed": "node ../scripts/generate-scenario-seed.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:changed": "vitest run --changed",
    "test:related": "vitest related --run",
    "test:e2e": "npm run test:e2e:smoke",
    "test:e2e:smoke": "playwright test --grep @smoke --project=desktop --project=iphone-se",
    "test:e2e:layout": "playwright test e2e/layout.spec.ts --project=desktop --project=iphone-se --project=iphone-14-landscape --project=desktop-touch",
    "test:e2e:input": "playwright test e2e/inputAndSize.spec.ts --project=desktop --project=iphone-se --project=desktop-touch",
    "test:e2e:overlays": "playwright test e2e/legend.spec.ts e2e/actionLog.spec.ts e2e/mobileControls.spec.ts e2e/blockDialog.spec.ts --project=desktop --project=iphone-se --project=iphone-14-landscape",
    "test:e2e:home": "playwright test e2e/home.spec.ts e2e/helpScreen.spec.ts e2e/settings.spec.ts --project=desktop --project=iphone-se",
    "test:e2e:branches": "playwright test e2e/branchReviewLayout.spec.ts e2e/playerComparison.spec.ts --project=desktop --project=iphone-se",
    "test:e2e:tutorial": "playwright test e2e/tutorialGuide.spec.ts --project=desktop --project=iphone-se",
    "test:e2e:admin": "playwright test e2e/puzzleCreatorLayout.spec.ts --project=desktop --project=iphone-se --project=ipad-mini",
    "test:e2e:mobile": "playwright test --project=iphone-se",
    "test:e2e:graphics": "npm run test:e2e:layout && npm run test:e2e:overlays",
    "test:e2e:full": "playwright test --config=playwright.full.config.ts"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.8",
    "@fontsource/source-sans-3": "^5.2.8",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.10"
  }
}
